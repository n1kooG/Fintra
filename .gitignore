# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local state (never commit)
.claude/
.claude-plans/

# lienzo de diseno: los .dc.html y canvas.json son la fuente; el .html sembrado
# es un artefacto de build de ~2-3MB (el editor completo embebido) y ya esta
# publicado como Artifact, asi que no hace falta versionarlo
design/**/*-sistema-nucleo.html

# documentacion interna del proyecto (introduccion, flujos, requerimientos):
# material de planificacion, no parte del codigo que se despliega
/documentacion/

# playwright
/test-results/
/playwright-report/

# notas para asistentes de codigo (next dev regenera AGENTS.md)
AGENTS.md
CLAUDE.md
